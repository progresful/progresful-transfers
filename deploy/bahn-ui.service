# bahn-ui.service - the read-only board (bahn.emplv.com). deploy/install.sh installs it.
[Unit]
Description=Progresful board: live map and replay of the Spread runs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bahn
WorkingDirectory=/srv/bahn
Environment=TZ=Europe/Helsinki
# Bound to loopback; Caddy is the only public entry point. The board reads the run logs
# and the public feed of a final; it never uses the team key.
ExecStart=/srv/bahn/hc ui -addr 127.0.0.1:8790 -team Progresful
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/bahn

[Install]
WantedBy=multi-user.target
